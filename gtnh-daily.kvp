Meta.DisplayName=GT New Horizons (Daily)
Meta.Description=GregTech: New Horizons server kept on the daily or experimental build by gtnh-daily-updater
Meta.OS=Windows, Linux
Meta.AarchSupport=Native
Meta.Arch=All
Meta.Author=Navatusein
Meta.URL=https://github.com/Caedis/gtnh-daily-updater
Meta.DisplayImageSource=url:https://avatars.githubusercontent.com/u/12788076?v=4
Meta.EndpointURIFormat={ip}:{GenericModule.App.Ports.$ServerPort}
Meta.ConfigManifest=gtnh-dailyconfig.json
Meta.MetaConfigManifest=gtnh-dailymetaconfig.json
Meta.ConfigRoot=gtnh-daily.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:java-lts
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["git","unzip"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=83ed4e12-93a4-4f15-bc7c-36a482731526
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=True
App.DisplayName=GT New Horizons
App.RootDir=./gtnh/
App.BaseDirectory=./gtnh/server/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin={{JavaVersion}}
App.ExecutableLinux={{JavaVersion}}
App.WorkingDir=server
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=-Xms{{MinMemory}}M -Xmx{{MaxMemory}}M -Dfml.readTimeout=180 {{AdditionalJavaArgs}} @java9args.txt -jar lwjgl3ify-forgePatches.jar nogui
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={}
App.CommandLineParameterFormat=--{0}={1}
App.CommandLineParameterDelimiter=
App.ExitMethod=String
App.ExitTimeout=180
App.ExitString=stop
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[gtnh-dailyports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=ServerPort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=20
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=list
App.TelnetLoginFormat={0}
App.UpdateSources=@IncludeJson[gtnh-dailyupdates.json]
App.PreStartStages=[]
App.UserActions=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.SmartExcludeExemptions=["*.cfg","*.conf","*.config","*.ini","*.json","*.xml","*.properties","*.kvp","*.yml","*.yaml","*.toml","*.lua","*.txt","*.zs"]
App.SmartExcludeSupported=True
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=
App.MonitorDirectChildOnly=False
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=\e\[(\d+;)*(\d+)?[ABCDHJKfmsu]|\e\[?[?\>\=\da-z]+
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
Console.AppReadyRegex=^\[[\d:]+\] \[Server thread/INFO\](?: \[[^\]]*\])?: Done \([\d.,]+s\)! For help, type "help" or "\?"$
Console.UserJoinRegex=^\[[\d:]+\] \[Server thread/INFO\](?: \[[^\]]*\])?: (?<username>\w{1,16}) joined the game$
Console.UserLeaveRegex=^\[[\d:]+\] \[Server thread/INFO\](?: \[[^\]]*\])?: (?<username>\w{1,16}) left the game$
Console.UserChatRegex=^\[[\d:]+\] \[Server thread/INFO\](?: \[[^\]]*\])?: <(?<username>\w{1,16})> (?<message>.+)$
Console.UpdateAvailableRegex=
Console.ConnectIPRegex=^\[[\d:]+\] \[Server thread/INFO\](?: \[[^\]]*\])?: (?<username>\w{1,16})\[/(?<ip>[\d.:a-fA-F]+):\d+\] logged in with entity id.*$
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
